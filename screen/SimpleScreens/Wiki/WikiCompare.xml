<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        allow-extra-path="true" default-menu-include="false">

    <parameter name="wikiSpaceId" required="true"/>
    <parameter name="pagePath"/>
    <parameter name="versionNameLhs" required="true"/>
    <parameter name="versionNameRhs" required="true"/>

    <actions>
        <!-- <set field="extraPathNameList" from="sri.screenUrlInfo.extraPathNameList"/> -->
        <!-- the page's info in a map of its own, never the context, so no name of the request (pageReference) stands for
            the page's (SEC-SCR-81) -->
        <service-call name="org.moqui.resource.WikiServices.get#WikiPageInfo" out-map="pageInfo"
                in-map="{wikiSpaceId:wikiSpaceId, pagePath:pagePath}"/>
        <set field="diffHtml" from="''"/>
        <set field="diffUnified" from="''"/>
        <set field="diffStats" from="null"/>
        <set field="pageName" from="null"/>
        <!-- no such space, or a page the user may not view: nothing of it is read -->
        <if condition="ec.message.hasError()"><return/></if>
        <set field="pageName" from="pageInfo.pageName"/>
        <set field="wikiType" from="pageInfo.wikiType || 'md'"/>
        <!-- the line diff is made on the server (ResourceReference.getVersionDiff): an HTML table with every text escaped;
            the Java screen diffed characters in the browser with jsdiff from a CDN -->
        <script><![CDATA[
            try {
                const diff = pageInfo.pageReference?.getVersionDiff(versionNameLhs, versionNameRhs)
                if (diff) {
                    diffHtml = diff.html
                    diffUnified = diff.unifiedDiff
                    diffStats = diff.stats.insertions + ' added, ' + diff.stats.deletions + ' removed'
                }
            } catch (err) {
                ec.message.addError('Cannot compare: ' + err.message)
            }
        ]]></script>
    </actions>
    <widgets>
        <container-box><box-header title="Compare ${pageName} versions ${versionNameLhs.substring(0, 12)} and ${versionNameRhs.substring(0, 12)}"/><box-toolbar>
            <label text="${diffStats || ''}" type="span"/>
            <link url="../wiki" text="Back to View"/>
        </box-toolbar><box-body>
        <render-mode><text type="html,vuet,qvt"><![CDATA[<div class="scroll">${diffHtml}</div>]]></text>
            <text type="tui"><![CDATA[{"t":"text","style":"pre","text":${JSON.stringify(diffUnified || '')}}]]></text></render-mode>
        </box-body></container-box>
    </widgets>
</screen>
