<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-include="false" standalone="true">

    <parameter name="wikiPageId"/>
    <parameter name="parentCommEventId"/>

    <!-- a reply to a comment of a page the user may view, from the user: the parent's thread is a page's comments
        (WikiPageCommunicationEvent) and get#WikiPageAccess lets the user view that page (plans/Security-Review.md SEC-RTE-81) -->
    <always-actions>
        <script><![CDATA[
            const parent = parentCommEventId ? ec.entity.find('mantle.party.communication.CommunicationEvent').condition('communicationEventId', parentCommEventId).one() : null
            const rootId = parent ? (parent.rootCommEventId || parent.communicationEventId) : null
            const join = rootId ? ec.entity.find('mantle.party.communication.WikiPageCommunicationEvent').condition('communicationEventId', rootId).list()[0] : null
            const access = join ? ec.service.sync().name('org.moqui.resource.WikiServices.get#WikiPageAccess').parameter('wikiPageId', join.wikiPageId).call() : null
            if (!access?.canView) throw new Error(`Comment ${parentCommEventId} not found`)
        ]]></script>
    </always-actions>

    <transition name="replyComment">
        <service-call name="mantle.party.CommunicationServices.reply#CommunicationEvent"
                in-map="{parentCommEventId:parentCommEventId, subject:subject, body:body, fromPartyId:ec.user.userAccount?.partyId}"/>
        <default-response url=".."/>
    </transition>

    <actions>
        <entity-find-one entity-name="mantle.party.communication.CommunicationEvent" value-field="communicationEvent">
            <field-map field-name="communicationEventId" from="parentCommEventId"/>
        </entity-find-one>
    </actions>
    <widgets>
        <form-single name="ReplyCommentForm" transition="replyComment">
            <field name="wikiPageId"><default-field><hidden/></default-field></field>
            <field name="parentCommEventId"><default-field><hidden/></default-field></field>
            <field name="subject"><default-field><text-line default-value="Re: ${communicationEvent.subject}"/></default-field></field>
            <field name="body"><default-field title="Comment"><text-area rows="10"/></default-field></field>
            <field name="submitButton"><default-field title="Reply"><submit/></default-field></field>
        </form-single>
    </widgets>
</screen>
