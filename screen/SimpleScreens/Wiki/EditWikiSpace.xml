<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Wiki Space" default-menu-index="1">

    <parameter name="wikiSpaceId" required="true"/>

    <!-- the entity-auto update checks nothing: a space's settings are changed by its administrators (get#WikiPageAccess
        canAdmin), and only the fields of the form, never a script, decorator or root setting of the request (SEC-SCR-81;
        Wiki.eecas.xml checks who may set allowAnyHtml) -->
    <transition name="updateSpace">
        <actions>
            <service-call name="org.moqui.resource.WikiServices.get#WikiPageAccess" in-map="{wikiSpaceId:wikiSpaceId}" out-map="spaceAccess"/>
            <if condition="!spaceAccess.canAdmin"><return error="true" message="Only an administrator of space ${wikiSpaceId} changes its settings"/></if>
            <service-call name="update#moqui.resource.wiki.WikiSpace" in-map="{wikiSpaceId:wikiSpaceId, description:description,
                    publicPageUrl:publicPageUrl, publicAttachmentUrl:publicAttachmentUrl, publicBlogUrl:publicBlogUrl,
                    restrictView:restrictView, restrictUpdate:restrictUpdate, allowAnyHtml:allowAnyHtml}"/>
        </actions>
        <default-response url="."/><error-response url="."/></transition>
    <transition name="indexPages">
        <service-call name="org.moqui.search.SearchServices.index#WikiSpacePages"
                      in-map="Object.assign({}, context, {dataDocumentId:'MantleWikiPage'})"/>
        <default-response url="."/>
    </transition>
    <transition name="cloneWikiSpace" begin-transaction="false">
        <actions>
            <!-- a script page (.fancy) runs on the server for whoever views it, so only a holder of DATABASE_ADMIN copies one
                (clone#WikiSpace refuses it, SEC-SCR-81): say so, naming the pages, before any of the copy is made -->
            <script><![CDATA[
                const types = ec.service.sync().name('org.moqui.resource.WikiServices.get#WikiPageTypes').call()
                const base = types.scriptTypes ? null : ec.entity.find('moqui.resource.wiki.WikiSpace').condition('wikiSpaceId', baseWikiSpaceId).one()
                const scriptPages = []
                if (base?.rootPageLocation) {
                    const rootRef = ec.resource.getLocationReference(base.rootPageLocation)
                    if (/\.fancy$/i.test(String(base.rootPageLocation))) scriptPages.push(rootRef.fileName || base.rootPageLocation)
                    const dirRef = rootRef.findMatchingDirectory()
                    const files = []
                    if (dirRef?.exists) dirRef.walkChildTree(files, null)
                    for (const file of files) if (/\.fancy$/i.test(String(file.location || file.name || ''))) scriptPages.push(file.path || file.name)
                }
                if (scriptPages.length) ec.message.addError(ec.resource.expand(ec.l10n.localize('Space ${baseWikiSpaceId} has script pages (${pageNames}), which run on the server for whoever views them: only a holder of the DATABASE_ADMIN permission copies them. Ask a database administrator to clone this space, or remove those pages first.'),
                        '', {baseWikiSpaceId, pageNames: scriptPages.slice(0, 5).join(', ') + (scriptPages.length > 5 ? ', ...' : '')}, false))
            ]]></script>
            <if condition="ec.message.hasError()"><return/></if>
            <service-call name="org.moqui.resource.WikiServices.clone#WikiSpace" in-map="context"/>
        </actions>
        <default-response url="."/><error-response url="."/>
    </transition>

    <actions>
        <entity-find-one entity-name="moqui.resource.wiki.WikiSpace" value-field="wikiSpace"/>
    </actions>
    <widgets>
        <link text="View Space" url="../wiki/${wikiSpaceId}" link-type="anchor-button"/>
        <link text="Index Space Pages" url="indexPages" link-type="hidden-form"/>

        <container-dialog id="CloneSpaceDialog" button-text="Clone Space">
            <form-single name="CloneSpace" transition="cloneWikiSpace">
                <field name="baseWikiSpaceId" from="wikiSpaceId"><default-field title="Base Space ID">
                    <display/></default-field></field>
                <field name="wikiSpaceId"><default-field title="New Space ID">
                    <text-line size="8" maxlength="8"/></default-field></field>
                <field name="description" from="wikiSpace.description"><default-field>
                    <text-line size="40"/></default-field></field>

                <!-- a space's own place in the database for anyone; another directory or location takes pages from wherever it
                    names, so only a system administrator gives one (Wiki.eecas.xml) -->
                <field name="rootPageDirectory"><default-field>
                    <drop-down combo-box="true">
                        <option key="dbresource://WikiSpace" text="Database (dbresource://WikiSpace)"/>
                        <option key="WikiSpace" text="runtime/WikiSpace (system administrators only)"/>
                        <option key="content://main/WikiSpace" text="content://main/WikiSpace (system administrators only)"/>
                    </drop-down>
                </default-field></field>
                <field name="rootPageLocation"><default-field title="Root Page Override" tooltip="System administrators only. Select a root page directory unless you know what you're doing and really need this, should end in filename with extension based on wiki type like .md">
                    <text-line size="60"/>
                </default-field></field>

                <field name="copyAttachments"><default-field>
                    <radio no-current-selected-key="true"><option key="true" text="Yes"/><option key="false" text="No"/></radio>
                </default-field></field>
                <field name="publishNew"><default-field>
                    <radio no-current-selected-key="true"><option key="true" text="Yes"/><option key="false" text="No"/></radio>
                </default-field></field>

                <field name="submitButton"><default-field title="Clone Space"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <form-single name="EditSpace" map="wikiSpace" transition="updateSpace">
            <field name="wikiSpaceId"><default-field><hidden/></default-field></field>

            <field name="description"><default-field><text-line size="60"/></default-field></field>
            <field name="rootPageLocation"><default-field>
                <display/>
                <!-- easy to break stuff if edited, should be done through Tools app: <text-line size="80"/> -->
            </default-field></field>
            <!-- <field name="decoratorScreenLocation"><default-field><text-line size="80"/></default-field></field> -->
            <field name="publicPageUrl"><default-field><text-line size="80"/></default-field></field>
            <field name="publicAttachmentUrl"><default-field><text-line size="80"/></default-field></field>
            <field name="publicBlogUrl"><default-field><text-line size="80"/></default-field></field>

            <field name="restrictView"><default-field><drop-down no-current-selected-key="N">
                <option key="N"/><option key="Y"/></drop-down></default-field></field>
            <field name="restrictUpdate"><default-field><drop-down no-current-selected-key="N">
                <option key="N"/><option key="Y"/></drop-down></default-field></field>
            <field name="allowAnyHtml"><default-field title="Allow Any HTML" tooltip="Y only for a system administrator"><drop-down no-current-selected-key="N">
                <option key="N"/><option key="Y"/></drop-down></default-field></field>

            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
        </form-single>
    </widgets>
</screen>
