<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        default-menu-title="Requests" default-menu-index="5" menu-image="/ssstatic/images/Request.png">

    <subscreens default-item="FindRequest"/>
    <!-- a request kept from the user inside their organizations (a confidential HR case, a maintenance problem outside their
        Maintenance reach) is not available here, by Mantle's rule for each search hit (SearchScope.js hitHidden; SEC-DAT-98):
        on every render and transition of its screens, as a missing one -->
    <always-actions>
        <if condition="requestId">
            <entity-find-one entity-name="mantle.request.Request" value-field="scopedRequest" auto-field-map="false">
                <field-map field-name="requestId"/></entity-find-one>
            <if condition="scopedRequest != null &amp;&amp; ec.resource.script('component://mr-mantle/service/mantle/search/SearchScope.js')
                    .hitHidden('MantleRequest', scopedRequest, ec.user.userAccount?.partyId || null)">
                <return error="true" message="RECORD_UNAVAILABLE: Request ${requestId} is not available"/></if>
        </if>
    </always-actions>
    <widgets><subscreens-panel id="RequestPanel" type="tab"/></widgets>
</screen>
