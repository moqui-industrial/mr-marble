<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Tasks" default-menu-index="4" menu-image="/ssstatic/images/task-homework.png">

    <subscreens default-item="FindTask"/>
    <!-- a task kept from the user inside their organizations (a protected People task, a confidential Smithy issue's, a
        maintenance work order outside their Maintenance reach) is not available here, by Mantle's rule for each search hit
        (SearchScope.js hitHidden; SEC-DAT-98): on every render and transition of its screens, as a missing one -->
    <always-actions>
        <if condition="workEffortId">
            <!-- a few reads a request, kept for the request (template/party/RecordScope.js) -->
            <if condition="ec.resource.script('component://mr-marble/template/party/RecordScope.js').taskHidden(workEffortId)">
                <return error="true" message="RECORD_UNAVAILABLE: Task ${workEffortId} is not available"/></if>
        </if>
    </always-actions>

    <actions>
        <if condition="workEffortId">
            <entity-find-one entity-name="mantle.work.effort.WorkEffort" value-field="task"/>
            <if condition="task == null"><return error="true" message="Task not found for ID ${workEffortId}"/></if>
        </if>
    </actions>
    <widgets>
        <label text="Task ${task.workEffortId} - ${task.workEffortName}" type="strong" condition="task != null"/>
        <subscreens-panel id="task-panel" type="tab"/>
    </widgets>
</screen>
