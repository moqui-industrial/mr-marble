<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/mr-xml-screen.xsd"
        default-menu-title="Requests" default-menu-index="14">

    <parameter name="partyId" required="true"/>

    <!-- a party is put on a request only that the user's organizations' rules admit (SEC-DAT-98) -->
    <transition name="addUser"><condition><expression>!ec.resource.script('component://mr-marble/template/party/RecordScope.js').requestHidden(requestId)</expression></condition><service-call name="create#mantle.request.RequestParty" in-map="context"/>
        <default-response url="."/></transition>
    <transition name="updateUser"><condition><expression>!ec.resource.script('component://mr-marble/template/party/RecordScope.js').requestHidden(requestId)</expression></condition><service-call name="update#mantle.request.RequestParty" in-map="context"/>
        <default-response url="."/></transition>
    <transition name="editRequest"><default-response url="//${appRoot}/Request/EditRequest"/></transition>

    <actions>
        <entity-find entity-name="mantle.request.RequestAndParty" list="rapList">
            <econdition field-name="partyId"/></entity-find>
        <!-- a request kept from the user inside their organizations (an HR case, a maintenance problem outside their reach) is
            neither listed here nor offered to add the party to (template/party/RecordScope.js, SEC-DAT-98) -->
        <set field="recordScope" from="ec.resource.script('component://mr-marble/template/party/RecordScope.js')"/>
        <set field="rapList" from="Array.from(rapList).filter((row) =&gt; row.requestTypeEnumId != 'RqtHrCase' &amp;&amp; !recordScope.requestHidden(row.requestId))"/>
        <entity-find entity-name="mantle.request.Request" list="openRequestList" limit="200">
            <econdition field-name="statusId" operator="not-in" value="ReqCompleted,ReqCancelled"/>
            <econdition field-name="requestTypeEnumId" operator="not-equals" value="RqtHrCase" or-null="true"/>
            <order-by field-name="-requestDate"/></entity-find>
        <set field="openRequestList" from="Array.from(openRequestList).filter((row) =&gt; !recordScope.requestHidden(row.requestId))"/>
    </actions>
    <widgets>
        <container-dialog id="AddUserDialog" button-text="Add to Request">
            <form-single name="AddUserForm" transition="addUser">
                <field name="partyId"><default-field><hidden/></default-field></field>

                <field name="requestId"><default-field title="Request"><drop-down combo-box="true">
                    <list-options list="openRequestList" key="${requestId}" text="${requestId} - ${requestName}"/>
                </drop-down></default-field></field>

                <field name="roleTypeId"><default-field title="Role">
                    <drop-down>
                        <entity-options key="${roleTypeId}" text="${description}">
                            <entity-find entity-name="mantle.party.RoleGroupMemberAndType" cache="true">
                                <econdition field-name="roleGroupEnumId" value="RgpRequest"/>
                                <order-by field-name="description"/></entity-find></entity-options>
                    </drop-down>
                </default-field></field>

                <field name="fromDate" from="ec.user.nowTimestamp"><header-field show-order-by="true"/><default-field><date-time/></default-field></field>
                <field name="thruDate"><header-field show-order-by="true"/><default-field><date-time/></default-field></field>

                <field name="receiveNotifications"><default-field>
                    <drop-down no-current-selected-key="N"><option key="Y"/><option key="N"/></drop-down>
                </default-field></field>

                <field name="submitButton"><default-field title="Add Request"><submit/></default-field></field>
            </form-single>
        </container-dialog>

        <form-list name="UpdateUserForm" list="rapList" transition="updateUser">
            <field name="partyId"><default-field><hidden/></default-field></field>

            <field name="requestId"><default-field title="ID">
                <link text="${requestId}" url="editRequest" link-type="anchor"/>
                <!-- a link does not post, and the row's update needs the request in its key -->
                <hidden/></default-field></field>
            <field name="requestName"><default-field title="Name"><display/></default-field></field>
            <field name="roleTypeId"><header-field title="Role" show-order-by="true"/>
                <default-field><display-entity entity-name="RoleType" text="${description}"/></default-field></field>

            <field name="fromDate"><header-field show-order-by="true"/><default-field><display/></default-field></field>
            <field name="thruDate"><header-field show-order-by="true"/><default-field><date-time/></default-field></field>

            <field name="receiveNotifications"><default-field title="Notifs?">
                <drop-down no-current-selected-key="N"><option key="Y"/><option key="N"/></drop-down>
            </default-field></field>

            <field name="submitButton"><default-field title="Update"><submit/></default-field></field>
        </form-list>
    </widgets>
</screen>
